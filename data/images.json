    {
      "file": "images/mary-angels.jpg",
      "caption": "聖母與眾天使",
      "for": ["our-father"]
    },
    {
      "file": "images/hail-mary.jpg",
      "caption": "聖母無玷聖心",
      "for": ["hail-mary"]
    },
    {
      "file": "images/gethsemane.jpg",
      "caption": "山園祈禱",
      "for": ["eternal-father"]
    },
    {
      "file": "images/divine-mercy-glass.jpg",
      "caption": "慈悲耶穌",
      "for": ["creed", "holy-god"]
    },

    { "file": "images/placeholder-rays.svg",  "caption": "耶穌，我信賴祢",
      "for": ["home", "done", "jesus-king", "passion"] },
    { "file": "images/placeholder-heart.svg", "caption": "仁慈的聖心",
