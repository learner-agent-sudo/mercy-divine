    "hail-mary": "聖母經",
    "creed": "信經",
    "eternal-father": "每端大珠（永生之父⋯）",
    "passion": "每端小珠（因祂的至悲慘苦難⋯）",
    "holy-god": "結束祈禱（至聖天主⋯）",
    "jesus-king": "信賴禱詞（主耶穌，慈悲的君王⋯）",
    "done": "誦畢畫面"
  },
  "images": [
    {
      "file": "images/divine-mercy.jpg",
      "caption": "耶穌，我信賴祢",
