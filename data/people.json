          "title": "往耶路撒冷",
          "sayings": [
            { "id": "disciples-who-sinned", "title": "誰犯了罪？是他，還是他的父母", "to": "耶穌", "refs": { "jhn": ["9:2"] }, "key": "jhn 9:2", "reply": { "jhn": ["9:3"] }, "replyBy": "耶穌", "note": "他們看見一個生來瞎眼的人（9:1）。" },
            { "id": "disciples-teach-prayer", "title": "請教給我們祈禱", "to": "耶穌", "refs": { "luk": ["11:1"] }, "key": "luk 11:1", "reply": { "luk": ["11:2-4"] }, "replyBy": "耶穌", "note": "「他的一個門徒」提出，說的是「我們」；瑪6:9-13 另有較長的主禱文，放在山上聖訓裡。" },
            { "id": "disciples-lazarus", "title": "近來猶太人圖謀砸死你", "to": "耶穌", "refs": { "jhn": ["11:8", "11:12"] }, "key": "jhn 11:8", "reply": { "jhn": ["11:14"] }, "replyBy": "耶穌", "note": "第二句「若是他睡著了，必定好了」：他們以為耶穌說的是安眠（11:12-13）。", "see": ["thomas-die-with-him"] },
            { "id": "disciples-increase-faith", "title": "請增加我們的信德罷", "to": "主", "refs": { "luk": ["17:5"] }, "key": "luk 17:5", "reply": { "luk": ["17:6"] }, "replyBy": "主", "note": "路17:5 稱「宗徒們」；耶穌答以芥子的比喻（17:6）。" },
            { "id": "disciples-where", "title": "主，在那裡呢", "to": "耶穌", "refs": { "luk": ["17:37"] }, "key": "luk 17:37", "note": "耶穌剛講人子顯現的日子（17:22-35）；他在同節回答。" },
            { "id": "disciples-marriage", "title": "倒不如不娶的好", "to": "耶穌", "refs": { "mat": ["19:10"] }, "key": "mat 19:10", "reply": { "mat": ["19:11-12"] }, "replyBy": "耶穌", "note": "接在耶穌論休妻之後（19:3-9）。" },
            { "id": "disciples-who-can-be-saved", "title": "這樣，誰還能得救呢", "to": "同伴", "refs": { "mat": ["19:25"], "mrk": ["10:26"], "luk": ["18:26"] }, "key": "mat 19:25", "reply": { "mat": ["19:26"], "mrk": ["10:27"], "luk": ["18:27"] }, "replyBy": "耶穌", "note": "接在富有青年離去之後；路18:26 作「聽眾」，不一定專指門徒。", "see": ["peter-left-everything"] },
            { "id": "disciples-hosanna", "title": "因上主之名而來的君王，應受讚頌", "to": "天主", "refs": { "luk": ["19:37-38"] }, "key": "luk 19:38", "reply": { "luk": ["19:40"] }, "replyBy": "耶穌", "note": "路19:37 稱「眾門徒」；瑪21:9、谷11:9、若12:13 記的是群眾的歡呼。" },
            { "id": "disciples-temple-stones", "title": "這是何等的石頭！何等的建築", "to": "耶穌", "refs": { "mrk": ["13:1"] }, "key": "mrk 13:1", "reply": { "mrk": ["13:2"] }, "replyBy": "耶穌", "note": "「他的門徒中有一個」說；瑪24:1、路21:5 只說有人指給他看或談論聖殿，沒有記話。", "see": ["peter-olivet-question"] }
          ]
        },
        {
          "title": "最後晚餐",
          "sayings": [
            { "id": "disciples-is-it-me", "title": "難道是我嗎", "to": "耶穌", "refs": { "mat": ["26:22"], "mrk": ["14:19"] }, "key": "mat 26:22", "reply": { "mat": ["26:23-24"], "mrk": ["14:20-21"] }, "replyBy": "耶穌", "note": "路22:23 只說他們彼此相問誰要做這事，是間接敘述；猶達斯的問見瑪26:25。", "see": ["judas-is-it-me", "peter-who-betrays"] },
            { "id": "disciples-little-while", "title": "我們不明白他講什麼", "to": "同伴", "refs": { "jhn": ["16:17-18"] }, "key": "jhn 16:18", "reply": { "jhn": ["16:19"] }, "replyBy": "耶穌", "note": "他們議論的是耶穌說的「只有片時，你們就看不見我了」（16:16）。", "see": ["disciples-now-plain"] },
            { "id": "disciples-now-plain", "title": "現在你明明地講論，不用什麼比喻了", "to": "耶穌", "refs": { "jhn": ["16:29-30"] }, "key": "jhn 16:30", "reply": { "jhn": ["16:31-32"] }, "replyBy": "耶穌", "note": "在告別講話的末尾，說「我們相信你是出自天主」（16:30）。", "see": ["disciples-little-while"] },
            { "id": "disciples-two-swords", "title": "主，看，這裡有兩把劍", "to": "耶穌", "refs": { "luk": ["22:35", "22:38"] }, "key": "luk 22:38", "note": "22:35 耶穌問他們派遣時缺少什麼，他們答「什麼也沒有缺」；耶穌在22:38 答「夠了」。", "see": ["disciples-strike-sword"] },
            { "id": "disciples-strike-sword", "title": "主，我們可以用劍砍嗎", "to": "耶穌", "refs": { "luk": ["22:49"] }, "key": "luk 22:49", "reply": { "luk": ["22:51"] }, "replyBy": "耶穌", "note": "路加作「耶穌左右的人」，隨即有一人砍了（22:50）；若18:10 說這人是西滿伯多祿。", "see": ["disciples-two-swords"] }
          ]
        },
        {
          "title": "復活之後",
          "sayings": [
            { "id": "disciples-we-saw-lord", "title": "我們看見了主", "to": "多默", "refs": { "jhn": ["20:25"] }, "key": "jhn 20:25", "note": "其他門徒對沒有在場的多默說；多默在同節回答「我決不信」。", "see": ["thomas-unless-i-see"] },
            { "id": "disciples-emmaus-hoped", "title": "我們原指望他就是那要拯救以色列的", "to": "耶穌", "refs": { "luk": ["24:18-24"] }, "key": "luk 24:21", "reply": { "luk": ["24:25-27"] }, "replyBy": "耶穌", "note": "兩個門徒之一名叫克羅帕（24:18），他們不是十二人；耶穌同行而他們認不出來（24:15-16）。", "see": ["disciples-emmaus-stay"] },
            { "id": "disciples-emmaus-stay", "title": "請同我們一起住下罷", "to": "耶穌", "refs": { "luk": ["24:29"] }, "key": "luk 24:29", "note": "耶穌裝作還要前行（24:28）；他們強留他。", "see": ["disciples-emmaus-hoped", "disciples-emmaus-hearts"] },
            { "id": "disciples-emmaus-hearts", "title": "我們的心不是火熱的嗎", "to": "同伴", "refs": { "luk": ["24:32"] }, "key": "luk 24:32", "note": "擘餅時他們認出耶穌，耶穌隨即隱沒（24:30-31）。", "see": ["disciples-emmaus-stay", "disciples-lord-risen"] },
            { "id": "disciples-lord-risen", "title": "主真復活了，並顯現給西滿了", "to": "厄瑪烏回來的人", "refs": { "luk": ["24:34"] }, "key": "luk 24:34", "note": "說話的是「十一門徒及同他們一起的人」；接著那二人述說路上的事（24:35）。", "see": ["disciples-emmaus-hearts"] },
            { "id": "disciples-no-fish", "title": "沒有", "to": "耶穌", "refs": { "jhn": ["21:5"] }, "key": "jhn 21:5", "reply": { "jhn": ["21:6"] }, "replyBy": "耶穌", "note": "耶穌站在岸上問「孩子們，你們有些魚吃嗎」，門徒還沒認出他（21:4）。", "see": ["peter-fishing", "peter-cast-nets"] }
          ]
        },
        {
          "title": "初期教會",
          "sayings": [
            { "id": "disciples-restore-kingdom", "title": "是此時要給以色列復興國家嗎", "to": "耶穌", "refs": { "act": ["1:6"] }, "key": "act 1:6", "reply": { "act": ["1:7-8"] }, "replyBy": "耶穌", "note": "耶穌復活後四十天之久向他們講論天主國的事（1:3）。" },
            { "id": "disciples-seven", "title": "我們要專務祈禱，並為真道服役", "to": "眾門徒", "refs": { "act": ["6:2-4"] }, "key": "act 6:4", "reply": { "act": ["6:5"] }, "replyBy": "全體", "note": "「十二宗徒召集眾門徒」說；起因是希臘化的猶太人抱怨寡婦被疏忽（6:1）。", "see": ["stephen-defense", "philip-deacon-understand"] }
          ]
        }
      ]
    },
    {
      "id": "stephen",
      "name": "斯德望",
      "group": "church",
      "intro": "宗徒選出的七人之一，充滿信德和聖神；在公議會辯護後，被石頭砸死。",
      "stages": [
        {
          "title": "在公議會前",
          "sayings": [
            { "id": "stephen-defense", "title": "你們時常反抗聖神", "to": "公議會", "refs": { "act": ["7:2-53"] }, "key": "act 7:51", "reply": { "act": ["7:54"] }, "replyBy": "公議會", "note": "回答大司祭的問話（7:1）；由亞巴郎、若瑟、梅瑟講到殿宇，最後責備聽眾（7:51-53）。", "see": ["stephen-forgive", "disciples-seven"] }
          ]
        },
        {
          "title": "殉道",
          "sayings": [
            { "id": "stephen-son-of-man", "title": "看，我見天開了", "to": "公議會", "refs": { "act": ["7:56"] }, "key": "act 7:56", "note": "對照耶穌在公議會前的話：人子要坐在大能者的右邊（瑪26:64、谷14:62、路22:69）。", "see": ["stephen-receive-spirit"] },
            { "id": "stephen-receive-spirit", "title": "主耶穌！接我的靈魂去罷", "to": "主耶穌", "refs": { "act": ["7:59"] }, "key": "act 7:59", "note": "對照路23:46：耶穌說「父啊！我把我的靈魂交托在你手中」。", "see": ["stephen-son-of-man", "stephen-forgive"] },
            { "id": "stephen-forgive", "title": "主，不要向他們算這罪債", "to": "主", "refs": { "act": ["7:60"] }, "key": "act 7:60", "note": "對照路23:34：耶穌說「父啊！寬赦他們罷」；證人把衣服放在名叫掃祿的青年人腳前（7:58）。", "see": ["paul-defence-crowd", "stephen-defense", "stephen-receive-spirit"] }
          ]
        }
      ]
    },
    {
      "id": "philip-deacon",
      "name": "斐理伯（執事）",
      "aka": ["傳福音者斐理伯"],
      "group": "church",
      "intro": "七位被選出的人之一，稱「傳福音者」（宗21:8）；在撒瑪黎雅傳教，又給厄提約丕雅的太監付洗。",
      "stages": [
        {
          "title": "往迦薩的路上",
          "sayings": [
            { "id": "philip-deacon-understand", "title": "你明白所誦讀的嗎", "to": "厄提約丕雅太監", "refs": { "act": ["8:30"] }, "key": "act 8:30", "reply": { "act": ["8:31"] }, "replyBy": "太監", "note": "聖神吩咐他走近那輛車子（8:29）；太監讀的是依撒意亞先知（8:28）。", "see": ["disciples-seven", "philip-deacon-believe"] },
            { "id": "philip-deacon-believe", "title": "你若全心相信，便可以", "to": "厄提約丕雅太監", "refs": { "act": ["8:37"] }, "key": "act 8:37", "note": "此節印在【】內；太監的宣認「我信耶穌基督就是天主子」在同一節。", "see": ["philip-deacon-understand"] }
          ]
        }
      ]
    },
    {
      "id": "paul",
      "name": "保祿",
      "aka": ["掃祿"],
      "group": "church",
      "intro": "原名掃祿，生於基里基雅的塔爾索，是法利塞人；在往大馬士革的路上被主召叫。",
      "stages": [
        {
          "title": "歸化",
          "sayings": [
            { "id": "paul-who-are-you", "title": "主！你是誰？", "to": "耶穌", "refs": { "act": ["9:5"] }, "key": "act 9:5", "reply": { "act": ["9:6"] }, "replyBy": "耶穌", "note": "此時他還叫掃祿；聲音先說「掃祿，掃祿，你為什麼迫害我？」（9:4）", "see": ["paul-defence-crowd", "paul-defence-agrippa"] }
          ]
        },
        {
          "title": "初次出外傳教",
          "sayings": [
            { "id": "paul-elymas", "title": "你這滿懷各種欺詐和各種奸惡的人", "to": "術士厄呂瑪", "refs": { "act": ["13:10-11"] }, "key": "act 13:10", "note": "經文在此說「掃祿，也即是保祿」（13:9）；術士立刻昏黑，找人領路（13:11）。", "see": ["peter-simon-magus"] },
            { "id": "paul-antioch-speech", "title": "憑著他，凡信的人都可成義", "to": "會堂裡的人", "refs": { "act": ["13:16-41"] }, "key": "act 13:39", "reply": { "act": ["13:42"] }, "replyBy": "眾人", "note": "在丕息狄雅的安提約基雅；與宗2 伯多祿的講辭同引「聖者不見腐朽」（宗2:27、13:35）。", "see": ["peter-pentecost", "paul-turn-to-gentiles"] },
            { "id": "paul-turn-to-gentiles", "title": "我們就要轉向外邦人", "to": "猶太人", "refs": { "act": ["13:46-47"] }, "key": "act 13:46", "note": "與巴爾納伯一同說；猶太人看見眾多的人，滿心嫉妒（13:45）。", "see": ["paul-corinth-blood", "paul-rome-isaiah", "paul-antioch-speech"] },
            { "id": "paul-lame-lystra", "title": "直直地站起來", "to": "呂斯特辣的跛子", "refs": { "act": ["14:10"] }, "key": "act 14:10", "note": "此人由母胎中即是跛子（14:8）；群眾因此稱巴爾納伯和保祿為神（14:11-12）。", "see": ["peter-no-silver", "paul-lystra-speech"] },
            { "id": "paul-lystra-speech", "title": "我們也是人啊", "to": "呂斯特辣的群眾", "refs": { "act": ["14:15-17"] }, "key": "act 14:15", "note": "與巴爾納伯一同說，阻止群眾獻祭（14:13-14、18）。", "see": ["peter-just-a-man", "paul-areopagus", "paul-lame-lystra"] }
          ]
        },
        {
          "title": "二次出外傳教",
          "sayings": [
            { "id": "paul-split-barnabas", "title": "看看弟兄怎麼樣了", "to": "巴爾納伯", "refs": { "act": ["15:36"] }, "key": "act 15:36", "note": "巴爾納伯想帶馬爾谷同去，保祿不同意，二人起了爭執而分離（15:37-39）。" },
            { "id": "paul-spirit-girl", "title": "命你從她身上出去", "to": "那惡神", "refs": { "act": ["16:18"] }, "key": "act 16:18", "note": "在斐理伯；附占卜之神的女孩多日跟著他們喊叫（16:16-18），她的主人們因此控告他們（16:19-21）。" },
            { "id": "paul-jailer-calm", "title": "不要傷害自己", "to": "獄警", "refs": { "act": ["16:28"] }, "key": "act 16:28", "note": "地震後監門全開，獄警以為囚犯逃走，拔劍想要自殺（16:26-27）。", "see": ["paul-jailer-believe"] },
            { "id": "paul-jailer-believe", "title": "你信主耶穌罷！你和你一家就必得救", "to": "獄警", "refs": { "act": ["16:31"] }, "key": "act 16:31", "note": "與息拉一同說（「他們說」）；獄警先問「我當作什麼纔可得救」（16:30）。", "see": ["paul-jailer-calm"] },
            { "id": "paul-roman-citizens", "title": "我們是羅馬人", "to": "官長的侍衛", "refs": { "act": ["16:37"] }, "key": "act 16:37", "note": "官長聽說他們是羅馬人就害怕了（16:38）；對照宗22:25-28。", "see": ["paul-roman-citizen"] },
            { "id": "paul-thessalonica", "title": "我向你們所傳報的耶穌，就是默西亞", "to": "猶太人", "refs": { "act": ["17:3"] }, "key": "act 17:3", "note": "在得撒洛尼的會堂，一連三個安息日根據聖經辯論（17:1-3）。" },
            { "id": "paul-areopagus", "title": "我們生活、行動、存在，都在他內", "to": "雅典人", "refs": { "act": ["17:22-31"] }, "key": "act 17:28", "reply": { "act": ["17:32"] }, "replyBy": "聽眾", "note": "在阿勒約帕哥；引雅典祭壇上的「給未識之神」（17:23）和詩人的話（17:28）。", "see": ["paul-lystra-speech"] },
            { "id": "paul-corinth-blood", "title": "從今以後，我要到外邦人那裡去了", "to": "格林多的猶太人", "refs": { "act": ["18:6"] }, "key": "act 18:6", "note": "猶太人反對並說褻瀆的話（18:6）；對照宗13:46-47 和宗28:28。", "see": ["paul-turn-to-gentiles", "paul-rome-isaiah"] },
            { "id": "paul-ephesus-promise", "title": "我還要回到你們這裡來", "to": "厄弗所的猶太人", "refs": { "act": ["18:21"] }, "key": "act 18:21", "note": "眾人求他多住些時候，他沒有應允（18:20）；他後來又到了厄弗所（19:1）。", "see": ["paul-miletus"] }
          ]
        },
        {
          "title": "三次出外傳教",
          "sayings": [
            { "id": "paul-ephesus-disciples", "title": "你們信教的時候，領了聖神沒有", "to": "厄弗所的幾個門徒", "refs": { "act": ["19:2-4"] }, "key": "act 19:2", "note": "他們只受過若翰的洗；聽了以後因主耶穌之名領洗，聖神降在他們身上（19:5-6）。" },
            { "id": "paul-see-rome", "title": "也該看看羅馬", "to": "自己", "refs": { "act": ["19:21"] }, "key": "act 19:21", "note": "他決意經馬其頓和阿哈雅往耶路撒冷去（19:21）；宗28:14-16 他到達羅馬。", "see": ["paul-rome-jews"] },
            { "id": "paul-eutychus", "title": "他的靈魂還在他身上", "to": "特洛阿的信徒", "refs": { "act": ["20:10"] }, "key": "act 20:10", "note": "青年厄烏提曷從三樓墮下，扶起來時已經死了（20:9）；後來被領走時活著（20:12）。", "see": ["peter-tabitha"] },
            { "id": "paul-miletus", "title": "施予比領受更為有福", "to": "厄弗所的長老", "refs": { "act": ["20:18-35"] }, "key": "act 20:35", "note": "引主耶穌的話；眾人聽他說以後不得再見他的面，就大哭起來（20:25、37-38）。", "see": ["paul-ephesus-promise", "paul-dont-weep"] },
            { "id": "paul-dont-weep", "title": "你們為什麼啼哭，使我心碎呢", "to": "請求他的人", "refs": { "act": ["21:13"] }, "key": "act 21:13", "note": "先知阿加波用保祿的腰帶綁自己，預言他將被交在外邦人手中（21:11）。", "see": ["paul-miletus"] }
          ]
        },
        {
          "title": "保祿被捕",
          "sayings": [
            { "id": "paul-ask-to-speak", "title": "許我向你說句話嗎", "to": "千夫長", "refs": { "act": ["21:37", "21:39"] }, "key": "act 21:39", "note": "千夫長問他是否前些日子作亂的埃及人（21:38）；他說自己是塔爾索人。", "see": ["paul-defence-crowd", "james-paul-vow"] },
            { "id": "paul-defence-crowd", "title": "請聽我現在對你們的分辯", "to": "聖殿的群眾", "refs": { "act": ["22:1-21"] }, "key": "act 22:21", "reply": { "act": ["22:22"] }, "replyBy": "群眾", "note": "用希伯來話致辭（21:40）；再述大馬士革路上的事（22:6-16），並提到斯德望（22:20）。", "see": ["paul-who-are-you", "paul-defence-agrippa", "stephen-forgive", "paul-ask-to-speak"] },
            { "id": "paul-roman-citizen", "title": "一個羅馬人，又沒有被定罪", "to": "百夫長、千夫長", "refs": { "act": ["22:25", "22:27-28"] }, "key": "act 22:25", "note": "千夫長說他花大錢纔購得公民權，保祿答「我卻生來就是」（22:28）；對照宗16:37。", "see": ["paul-roman-citizens"] },
            { "id": "paul-good-conscience", "title": "全憑純善的良心，直到今天", "to": "公議會", "refs": { "act": ["23:1"] }, "key": "act 23:1", "note": "大司祭阿納尼雅隨即命站在旁邊的人打他的嘴（23:2）。", "see": ["paul-whitewashed"] },
            { "id": "paul-whitewashed", "title": "粉白的牆啊！天主將要打擊你", "to": "大司祭與旁人", "refs": { "act": ["23:3", "23:5"] }, "key": "act 23:3", "note": "旁人責他辱罵大司祭（23:4）；他答不知道他是大司祭，並引經上「不可詛咒你百姓的首長」。", "see": ["paul-good-conscience"] },
            { "id": "paul-resurrection-hope", "title": "我是為了希望死者的復活，現在受審", "to": "公議會", "refs": { "act": ["23:6"] }, "key": "act 23:6", "note": "他的話使法利塞人和撒杜塞人起了爭辯（23:7-9）。", "see": ["paul-felix"] },
            { "id": "paul-centurion-youth", "title": "請領這個青年到千夫長那裡去", "to": "一個百夫長", "refs": { "act": ["23:17"] }, "key": "act 23:17", "note": "保祿姊妹的兒子聽到四十多人的陰謀，來營裡報告（23:12-16）。" }
