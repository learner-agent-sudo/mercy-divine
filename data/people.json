            { "id": "philip-two-hundred", "title": "也不夠每人分得一小塊", "to": "耶穌", "refs": { "jhn": ["6:7"] }, "key": "jhn 6:7", "reply": { "jhn": ["6:8-9"] }, "replyBy": "安德肋", "note": "耶穌問他是為了試探他（6:5-6）；谷6:37 作門徒問「我們去買二百塊銀錢的餅給他們吃嗎」。", "see": ["andrew-five-loaves", "disciples-feed-crowd"] }
          ]
        },
        {
          "title": "最後晚餐",
          "sayings": [
            { "id": "philip-show-father", "title": "把父顯示給我們", "to": "耶穌", "refs": { "jhn": ["14:8"] }, "key": "jhn 14:8", "reply": { "jhn": ["14:9-11"] }, "replyBy": "耶穌", "note": "接在多默的發問之後（14:5）；之後猶達也發問（14:22）。", "see": ["thomas-which-way", "jude-show-world"] }
          ]
        }
      ]
    },
    {
      "id": "nathanael",
      "name": "納塔乃耳",
      "group": "twelve",
      "intro": "加里肋亞加納人（若21:2）；斐理伯把耶穌介紹給他，耶穌說他「毫無詭詐」。",
      "stages": [
        {
          "title": "初遇耶穌",
          "sayings": [
            { "id": "nathanael-nazareth", "title": "從納匝肋還能出什麼好事嗎", "to": "斐理伯", "refs": { "jhn": ["1:46"] }, "key": "jhn 1:46", "note": "斐理伯剛告訴他「我們找著了」那位出身納匝肋的耶穌（1:45）；斐理伯同節回答。", "see": ["philip-come-and-see"] },
            { "id": "nathanael-how-know", "title": "你從那裡認識我呢", "to": "耶穌", "refs": { "jhn": ["1:48"] }, "key": "jhn 1:48", "note": "耶穌在同節回答：「當你還在無花果樹下時，我就看見了你。」", "see": ["nathanael-son-of-god"] },
            { "id": "nathanael-son-of-god", "title": "你是天主子，你是以色列的君王", "to": "耶穌", "refs": { "jhn": ["1:49"] }, "key": "jhn 1:49", "reply": { "jhn": ["1:50-51"] }, "replyBy": "耶穌", "note": "稱耶穌「辣彼」，又稱「天主子」「以色列的君王」。", "see": ["peter-confess", "thomas-my-lord-my-god", "nathanael-how-know", "disciples-son-of-god"] }
          ]
        }
      ]
    },
    {
      "id": "thomas",
      "name": "多默",
      "aka": ["狄狄摩"],
      "group": "twelve",
      "intro": "十二人中的一個，號稱「狄狄摩」；他的話都記在若望福音。",
      "stages": [
        {
          "title": "受難之前",
          "sayings": [
            { "id": "thomas-die-with-him", "title": "我們也去，同他一起死罷", "to": "其他的同伴", "refs": { "jhn": ["11:16"] }, "key": "jhn 11:16", "note": "門徒剛提醒猶太人圖謀砸死耶穌（11:8）；耶穌說拉匝祿死了（11:14）。", "see": ["thomas-my-lord-my-god", "disciples-lazarus"] },
            { "id": "thomas-which-way", "title": "我們不知道你往那裡去", "to": "耶穌", "refs": { "jhn": ["14:5"] }, "key": "jhn 14:5", "reply": { "jhn": ["14:6-7"] }, "replyBy": "耶穌", "note": "耶穌剛說「我去的地方，你們知道往那裡去的路」（14:4）。", "see": ["philip-show-father", "jude-show-world"] }
          ]
        },
        {
          "title": "復活之後",
          "sayings": [
            { "id": "thomas-unless-i-see", "title": "我除非看見他手上的釘孔", "to": "其他門徒", "refs": { "jhn": ["20:25"] }, "key": "jhn 20:25", "reply": { "jhn": ["20:26-27"] }, "replyBy": "耶穌", "note": "耶穌第一次顯現時他不在場（20:24）；其他人告訴他「我們看見了主」。", "see": ["thomas-my-lord-my-god", "disciples-we-saw-lord"] },
            { "id": "thomas-my-lord-my-god", "title": "我主！我天主！", "to": "耶穌", "refs": { "jhn": ["20:28"] }, "key": "jhn 20:28", "reply": { "jhn": ["20:29"] }, "replyBy": "耶穌", "note": "八天以後耶穌再來，邀他伸指探入釘孔和肋膀（20:26-27）。", "see": ["thomas-die-with-him", "thomas-unless-i-see", "peter-confess", "nathanael-son-of-god"] }
          ]
        }
      ]
    },
