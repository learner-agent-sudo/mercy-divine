            { "id": "disciples-bury-father", "title": "請許我先去埋葬我的父親", "to": "耶穌", "refs": { "mat": ["8:21"], "luk": ["9:59"] }, "key": "mat 8:21", "reply": { "mat": ["8:22"], "luk": ["9:60"] }, "replyBy": "耶穌", "note": "瑪竇作「門徒中有一個」，未具名；路9:59 作耶穌召叫的「另一個人」。" },
            { "id": "disciples-storm", "title": "我們要喪亡了", "to": "耶穌", "refs": { "mat": ["8:25"], "mrk": ["4:38"], "luk": ["8:24"] }, "key": "mat 8:25", "reply": { "mat": ["8:26"], "mrk": ["4:39-40"], "luk": ["8:25"] }, "replyBy": "耶穌", "note": "耶穌在船上睡著；瑪作「主！救命啊」，谷作「你不管嗎」，路作「老師！老師」。", "see": ["disciples-who-is-this"] },
            { "id": "disciples-who-is-this", "title": "這人到底是誰", "to": "同伴", "refs": { "mat": ["8:27"], "mrk": ["4:41"], "luk": ["8:25"] }, "key": "mrk 4:41", "note": "瑪8:27 作「那些人」，谷、路作「他們」；都接在耶穌平定風浪之後。", "see": ["disciples-storm", "disciples-son-of-god"] },
            { "id": "disciples-why-parables", "title": "為什麼你用比喻對他們講話", "to": "耶穌", "refs": { "mat": ["13:10"] }, "key": "mat 13:10", "reply": { "mat": ["13:11-17"] }, "replyBy": "耶穌", "note": "谷4:10、路8:9 也記門徒問比喻的意義，只是間接敘述。" },
            { "id": "disciples-explain-weeds", "title": "請把田間莠子的比喻給我們講解一下", "to": "耶穌", "refs": { "mat": ["13:36"] }, "key": "mat 13:36", "reply": { "mat": ["13:37-43"] }, "replyBy": "耶穌", "note": "耶穌離開群眾回到家裡之後（13:36）。", "see": ["peter-explain-parable", "disciples-understood"] },
            { "id": "disciples-understood", "title": "是的", "to": "耶穌", "refs": { "mat": ["13:51"] }, "key": "mat 13:51", "note": "耶穌問：「這一切你們都明白了嗎？」他們答「是的」。", "see": ["disciples-explain-weeds"] },
            { "id": "disciples-feed-crowd", "title": "請遣散群眾", "to": "耶穌", "refs": { "mat": ["14:15", "14:17"], "mrk": ["6:35-38"], "luk": ["9:12-13"] }, "key": "mat 14:15", "note": "若6:5-9 同一件事記的是斐理伯和安德肋的話。", "see": ["philip-two-hundred", "andrew-five-loaves", "disciples-feed-four-thousand", "disciples-no-bread"] },
            { "id": "disciples-ghost", "title": "是個妖怪", "to": "同伴", "refs": { "mat": ["14:26"] }, "key": "mat 14:26", "reply": { "mat": ["14:27"] }, "replyBy": "耶穌", "note": "谷6:49 也說門徒以為是妖怪、驚叫起來，沒有記話。", "see": ["peter-walk-water"] },
            { "id": "disciples-son-of-god", "title": "你真是天主子", "to": "耶穌", "refs": { "mat": ["14:33"] }, "key": "mat 14:33", "note": "說話的是「船上的人」，在伯多祿行水、風停止之後（14:29-32）。", "see": ["disciples-who-is-this", "nathanael-son-of-god", "peter-confess"] },
            { "id": "disciples-hard-saying", "title": "這話生硬，誰能聽得下去呢", "to": "同伴", "refs": { "jhn": ["6:60"] }, "key": "jhn 6:60", "reply": { "jhn": ["6:61-65"] }, "replyBy": "耶穌", "note": "是「門徒中的許多人」，不是十二人；許多人退去（6:66）後，耶穌問十二人，由伯多祿回答。", "see": ["peter-words-of-life"] },
            { "id": "disciples-offended", "title": "法利塞人聽了這話，起了反感嗎", "to": "耶穌", "refs": { "mat": ["15:12"] }, "key": "mat 15:12", "reply": { "mat": ["15:13-14"] }, "replyBy": "耶穌", "note": "耶穌剛說「出於口的，纔使人污穢」（15:11）；伯多祿接著請他講解（15:15）。", "see": ["peter-explain-parable"] },
            { "id": "disciples-send-her-away", "title": "打發她走罷", "to": "耶穌", "refs": { "mat": ["15:23"] }, "key": "mat 15:23", "reply": { "mat": ["15:24"] }, "replyBy": "耶穌", "note": "那位客納罕婦人不停地喊叫求耶穌可憐她（15:22-23）。" },
            { "id": "disciples-feed-four-thousand", "title": "在荒野裡我們從那裡得這麼多的餅", "to": "耶穌", "refs": { "mat": ["15:33-34"], "mrk": ["8:4-5"] }, "key": "mat 15:33", "note": "耶穌問「你們有多少餅」，他們答「七個」（瑪15:34、谷8:5）；對照前一次餵飽群眾（瑪14:15-17）。", "see": ["disciples-feed-crowd", "disciples-no-bread"] },
            { "id": "disciples-no-bread", "title": "我們沒有帶餅", "to": "同伴", "refs": { "mat": ["16:7"], "mrk": ["8:19-20"] }, "key": "mat 16:7", "note": "谷8:16 只說他們彼此議論沒有餅了（間接敘述）；谷8:19-20 另記他們答耶穌所收的碎塊「十二筐」「七籃」。", "see": ["disciples-feed-crowd", "disciples-feed-four-thousand"] }
          ]
        },
        {
          "title": "認信前後",
          "sayings": [
            { "id": "disciples-people-say", "title": "有人說是洗者若翰", "to": "耶穌", "refs": { "mat": ["16:14"], "mrk": ["8:28"], "luk": ["9:19"] }, "key": "mat 16:14", "reply": { "mat": ["16:15"], "mrk": ["8:29"], "luk": ["9:20"] }, "replyBy": "耶穌", "note": "耶穌先問「人們說人子是誰」，再問「你們說我是誰」。", "see": ["peter-confess"] },
            { "id": "disciples-elijah", "title": "厄里亞應該先來呢", "to": "耶穌", "refs": { "mat": ["17:10"], "mrk": ["9:11"] }, "key": "mat 17:10", "reply": { "mat": ["17:11-13"], "mrk": ["9:12-13"] }, "replyBy": "耶穌", "note": "剛從變容的山上下來（瑪17:9）；谷9:11 的「他們」是上山的伯多祿、雅各伯、若望（谷9:2、9）。", "see": ["disciples-cast-out"] },
            { "id": "disciples-cast-out", "title": "為什麼我們不能逐出這魔鬼呢", "to": "耶穌", "refs": { "mat": ["17:19"], "mrk": ["9:28"] }, "key": "mat 17:19", "reply": { "mat": ["17:20"], "mrk": ["9:29"] }, "replyBy": "耶穌", "note": "山下一個孩子的父親說門徒不能治好他（瑪17:14-16）。", "see": ["disciples-elijah"] },
            { "id": "disciples-greatest", "title": "在天國裡究竟誰是最大的", "to": "耶穌", "refs": { "mat": ["18:1"] }, "key": "mat 18:1", "reply": { "mat": ["18:2-4"] }, "replyBy": "耶穌", "note": "谷9:33-35、路9:46-48 也記此事，只說他們爭論誰最大（間接敘述）；路22:24 晚餐時又有爭論。", "see": ["zebedee-seats", "zebedee-forbade"] }
          ]
        },
