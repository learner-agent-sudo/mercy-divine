{
  "groups": [
    { "id": "twelve", "title": "十二宗徒" },
    { "id": "church", "title": "初期教會" }
  ],
  "people": [
    {
      "id": "peter",
      "name": "伯多祿",
      "aka": ["西滿", "刻法"],
      "group": "twelve",
      "intro": "加里肋亞的漁夫，安德肋的哥哥。耶穌稱他為「磐石」，宗徒之首。",
      "stages": [
        {
          "title": "蒙召",
          "sayings": [
            { "id": "peter-cast-nets", "title": "我要遵照你的話撒網", "to": "耶穌", "refs": { "luk": ["5:5"] }, "key": "luk 5:5", "note": "路加把伯多祿蒙召放在一次奇蹟捕魚之後；瑪4:18-20、谷1:16-20 沒有記他的話。", "see": ["peter-sinner", "peter-fishing", "disciples-no-fish"] },
            { "id": "peter-sinner", "title": "主，請你離開我", "to": "耶穌", "refs": { "luk": ["5:8"] }, "key": "luk 5:8", "reply": { "luk": ["5:10"] }, "replyBy": "耶穌", "note": "在網了許多魚、船幾乎下沉之後（5:6-7）；同船的雅各伯和若望一樣驚駭。", "see": ["peter-cast-nets", "peter-fishing"] }
          ]
        },
        {
          "title": "跟隨耶穌",
          "sayings": [
            { "id": "peter-everyone-looks", "title": "眾人都找你呢", "to": "耶穌", "refs": { "mrk": ["1:37"] }, "key": "mrk 1:37", "reply": { "mrk": ["1:38"] }, "replyBy": "耶穌", "note": "「西滿和同他在一起的人」一起去追尋耶穌（1:36），所以說「眾人都找你」。" },
            { "id": "peter-crowd-pressing", "title": "群眾都在擁擠著你", "to": "耶穌", "refs": { "luk": ["8:45"], "mrk": ["5:31"] }, "key": "luk 8:45", "reply": { "luk": ["8:46"], "mrk": ["5:32"] }, "replyBy": "耶穌", "note": "路加說是伯多祿；谷5:31 作「他的門徒」。" },
            { "id": "peter-walk-water", "title": "主，救我罷", "to": "耶穌", "refs": { "mat": ["14:28", "14:30"] }, "key": "mat 14:30", "reply": { "mat": ["14:31"] }, "replyBy": "耶穌", "note": "只有瑪竇記伯多祿在水面上行走；谷6:45-52、若6:16-21 沒有這一段。", "see": ["disciples-ghost"] },
            { "id": "peter-explain-parable", "title": "請你給我們講解這個比喻罷", "to": "耶穌", "refs": { "mat": ["15:15"] }, "key": "mat 15:15", "reply": { "mat": ["15:16-20"] }, "replyBy": "耶穌", "note": "耶穌剛說「出於口的，纔使人污穢」（15:11）；谷7:17 作「門徒」問，沒有記話。", "see": ["disciples-offended", "disciples-explain-weeds"] }
          ]
        },
        {
          "title": "認信",
          "sayings": [
            { "id": "peter-words-of-life", "title": "惟你有永生的話", "to": "耶穌", "refs": { "jhn": ["6:68-69"] }, "key": "jhn 6:68", "reply": { "jhn": ["6:70"] }, "replyBy": "耶穌", "note": "許多門徒退去之後，耶穌問十二人：「難道你們也願走嗎？」（6:66-67）", "see": ["peter-confess", "disciples-hard-saying"] },
            { "id": "peter-confess", "title": "你是默西亞", "to": "耶穌", "refs": { "mat": ["16:16"], "mrk": ["8:29"], "luk": ["9:20"] }, "key": "mat 16:16", "reply": { "mat": ["16:17-19"], "mrk": ["8:30"], "luk": ["9:21"] }, "replyBy": "耶穌", "note": "三部福音說法不同：瑪竇最完整，多了「永生天主之子」；谷、路只說「默西亞」。", "see": ["peter-words-of-life", "peter-rebuke", "peter-pentecost", "disciples-people-say", "andrew-found-messiah", "nathanael-son-of-god", "thomas-my-lord-my-god", "disciples-son-of-god"] },
            { "id": "peter-rebuke", "title": "主，千萬不可", "to": "耶穌", "refs": { "mat": ["16:22"] }, "key": "mat 16:22", "reply": { "mat": ["16:23"] }, "replyBy": "耶穌", "note": "谷8:32 只說伯多祿「開始諫責」耶穌，沒有記下他的話；耶穌的回答見谷8:33。", "see": ["peter-confess", "peter-vision-joppa"] },
            { "id": "peter-booths", "title": "我們在這裡真好", "to": "耶穌", "refs": { "mat": ["17:4"], "mrk": ["9:5"], "luk": ["9:33"] }, "key": "mat 17:4", "reply": { "mat": ["17:5"], "mrk": ["9:7"], "luk": ["9:34-35"] }, "replyBy": "雲中聲音", "note": "谷9:6、路9:33 說他當時不知道該說什麼；瑪竇沒有這句。" }
          ]
        },
        {
          "title": "走向耶路撒冷",
          "sayings": [
            { "id": "peter-temple-tax", "title": "自然納的", "to": "收殿稅的人", "refs": { "mat": ["17:25", "17:26"] }, "key": "mat 17:25", "reply": { "mat": ["17:27"] }, "replyBy": "耶穌", "note": "只有瑪竇記這件事；耶穌先問他「西滿！你以為怎樣？」（17:25）" },
            { "id": "peter-seven-times", "title": "我該寬恕他多次", "to": "耶穌", "refs": { "mat": ["18:21"] }, "key": "mat 18:21", "reply": { "mat": ["18:22"] }, "replyBy": "耶穌", "note": "耶穌隨後講君王同僕人算賬的比喻（18:23-35）。" },
            { "id": "peter-parable-for-whom", "title": "是為我們呢，還是為眾人", "to": "耶穌", "refs": { "luk": ["12:41"] }, "key": "luk 12:41", "reply": { "luk": ["12:42"] }, "replyBy": "主", "note": "接在要醒寤準備的比喻之後（12:35-40）。" },
            { "id": "peter-left-everything", "title": "我們捨棄了一切", "to": "耶穌", "refs": { "mat": ["19:27"], "mrk": ["10:28"], "luk": ["18:28"] }, "key": "mat 19:27", "reply": { "mat": ["19:28-30"], "mrk": ["10:29-31"], "luk": ["18:29-30"] }, "replyBy": "耶穌", "note": "接在富有青年離去、「誰還能得救」的問答之後；只有瑪竇多問「將來我們可得到什麼」。", "see": ["disciples-who-can-be-saved"] },
            { "id": "peter-fig-tree", "title": "你所咒罵的無花果樹已枯乾了", "to": "耶穌", "refs": { "mrk": ["11:21"], "mat": ["21:20"] }, "key": "mrk 11:21", "reply": { "mrk": ["11:22-24"], "mat": ["21:21-22"] }, "replyBy": "耶穌", "note": "谷11:21 是伯多祿說；瑪21:20 作「門徒」驚異說：怎麼這無花果樹立即枯乾了。" },
            { "id": "peter-olivet-question", "title": "什麼時候發生這些事", "to": "耶穌", "refs": { "mrk": ["13:4"], "mat": ["24:3"], "luk": ["21:7"] }, "key": "mrk 13:4", "note": "谷13:3 指明是伯多祿、雅各伯、若望和安德肋私下問；瑪24:3 作「門徒」，路21:7 作「他們」。", "see": ["disciples-temple-stones"] }
          ]
        },
        {
          "title": "最後晚餐",
          "sayings": [
            { "id": "peter-passover-prep", "title": "你願意我們在那裡預備", "to": "耶穌", "refs": { "luk": ["22:9"], "mat": ["26:17"], "mrk": ["14:12"] }, "key": "luk 22:9", "reply": { "luk": ["22:10-12"], "mat": ["26:18"], "mrk": ["14:13-15"] }, "replyBy": "耶穌", "note": "路22:8 耶穌先打發伯多祿和若望，兩人再問；瑪26:17、谷14:12 是「門徒」先問。" },
            { "id": "peter-foot-washing", "title": "你永遠不可給我洗腳", "to": "耶穌", "refs": { "jhn": ["13:6", "13:8", "13:9"] }, "key": "jhn 13:8", "reply": { "jhn": ["13:10"] }, "replyBy": "耶穌", "note": "先拒絕（13:8），聽耶穌說「你就與我無分」，又要求連手帶頭都洗（13:9）。", "see": ["peter-never-fall"] },
            { "id": "peter-who-betrays", "title": "你問他說的是誰", "to": "耶穌所愛的門徒", "refs": { "jhn": ["13:24"] }, "key": "jhn 13:24", "note": "他向耶穌所愛的門徒示意，請他去問；那人再問耶穌「主！是誰？」（13:25）", "see": ["disciples-is-it-me", "judas-is-it-me"] },
            { "id": "peter-never-fall", "title": "我決不會跌倒", "to": "耶穌", "refs": { "mat": ["26:33", "26:35"], "mrk": ["14:29", "14:31"], "luk": ["22:33"], "jhn": ["13:36-37"] }, "key": "mat 26:33", "reply": { "mat": ["26:34"], "mrk": ["14:30"], "luk": ["22:34"], "jhn": ["13:38"] }, "replyBy": "耶穌", "note": "路22:33、若13:36-37 在晚餐席上；瑪、谷在往橄欖山的路上。眾門徒也這樣說（瑪26:35、谷14:31）。", "see": ["peter-deny", "peter-love", "peter-foot-washing"] }
          ]
        },
        {
          "title": "否認",
          "sayings": [
            { "id": "peter-deny", "title": "我不認識這個人", "to": "婢女與旁人", "refs": { "mat": ["26:70", "26:72", "26:74"], "mrk": ["14:68", "14:71"], "luk": ["22:57", "22:58", "22:60"], "jhn": ["18:17", "18:25"] }, "key": "mat 26:74", "note": "谷14:70、若18:27 只說他「又否認了」，沒有記話；瑪、谷、路記他想起耶穌的預言而痛哭。", "see": ["peter-never-fall", "peter-love"] }
          ]
        },
        {
          "title": "復活之後",
          "sayings": [
            { "id": "peter-fishing", "title": "我去打魚", "to": "眾門徒", "refs": { "jhn": ["21:3"] }, "key": "jhn 21:3", "note": "同船的有多默、納塔乃耳、載伯德的兩個兒子等人（21:2）；一夜沒有捕到，直到耶穌叫他們撒網（21:6）。", "see": ["peter-sinner", "peter-cast-nets", "disciples-no-fish", "peter-love"] },
            { "id": "peter-love", "title": "你知道我愛你", "to": "耶穌", "refs": { "jhn": ["21:15-17"] }, "key": "jhn 21:17", "note": "耶穌三次問「你愛我嗎」，對照他曾三次否認主。", "see": ["peter-deny", "peter-never-fall", "peter-fishing", "peter-what-about-him"] },
            { "id": "peter-what-about-him", "title": "主，他怎樣", "to": "耶穌", "refs": { "jhn": ["21:21"] }, "key": "jhn 21:21", "reply": { "jhn": ["21:22"] }, "replyBy": "耶穌", "note": "「他」指耶穌所愛的那個門徒（21:20）；21:23 說明兄弟們中間流傳的誤解。", "see": ["peter-love"] }
          ]
        },
        {
          "title": "五旬節的宣講",
          "sayings": [
            { "id": "peter-choose-matthias", "title": "作他復活的見證人", "to": "弟兄們", "refs": { "act": ["1:15-22"] }, "key": "act 1:22", "note": "補選猶達斯留下的缺；結果瑪弟亞當選（1:23-26）。", "see": ["judas-innocent-blood"] },
            { "id": "peter-pentecost", "title": "立為主，立為默西亞了", "to": "耶路撒冷的人", "refs": { "act": ["2:14-36"] }, "key": "act 2:36", "reply": { "act": ["2:37"] }, "replyBy": "聽眾", "note": "引岳厄爾先知（2:16-21）和達味的聖詠（2:25-28、34-35）。", "see": ["peter-repent", "peter-confess", "peter-cornelius-speech", "paul-antioch-speech"] },
            { "id": "peter-repent", "title": "你們悔改罷", "to": "聽眾", "refs": { "act": ["2:38-40"] }, "key": "act 2:38", "note": "回答聽眾的提問「我們該作什麼」（2:37）；當天約增添了三千人（2:41）。", "see": ["peter-pentecost", "peter-solomon-porch"] }
          ]
        },
        {
          "title": "見證與神蹟",
          "sayings": [
            { "id": "peter-no-silver", "title": "銀子和金子，我沒有", "to": "胎生的瘸子", "refs": { "act": ["3:4", "3:6"] }, "key": "act 3:6", "note": "與若望一起：3:4「你看我們！」是兩人同說；此人從母胎中就瘸了（3:2）。", "see": ["peter-solomon-porch", "paul-lame-lystra"] },
            { "id": "peter-solomon-porch", "title": "你們為什麼對這事驚奇", "to": "百姓", "refs": { "act": ["3:12-26"] }, "key": "act 3:19", "note": "在撒羅滿廊下，治好瘸子之後（3:11）；引梅瑟的話（3:22-23）。", "see": ["peter-no-silver", "peter-repent"] },
            { "id": "peter-sanhedrin-name", "title": "除他以外，無論憑誰，決無救援", "to": "公議會", "refs": { "act": ["4:8-12"] }, "key": "act 4:12", "note": "回答「你們憑什麼能力，或以誰的名義行這事」（4:7）；引「匠人所棄而不用的石頭」（4:11）。", "see": ["peter-cannot-keep-silent", "peter-obey-god"] },
            { "id": "peter-cannot-keep-silent", "title": "我們不得不說我們所見所聞的事", "to": "公議會", "refs": { "act": ["4:19-20"] }, "key": "act 4:20", "note": "與若望一起回答；公議會嚴令他們不可再因耶穌的名發言施教（4:18）。", "see": ["peter-sanhedrin-name", "peter-obey-god"] },
            { "id": "peter-ananias", "title": "為什麼撒殫充滿了你的心", "to": "阿納尼雅與撒斐辣", "refs": { "act": ["5:3-4", "5:8-9"] }, "key": "act 5:3", "note": "夫妻扣留了賣田價錢的一部分（5:2）；兩人先後當場斷氣（5:5、5:10）。", "see": ["peter-simon-magus"] },
            { "id": "peter-obey-god", "title": "聽天主的命應勝過聽人的命", "to": "公議會", "refs": { "act": ["5:29-32"] }, "key": "act 5:29", "reply": { "act": ["5:35-39"] }, "replyBy": "加瑪里耳", "note": "與眾宗徒一起回答大司祭的質問（5:27-28）。", "see": ["peter-cannot-keep-silent", "peter-sanhedrin-name"] },
            { "id": "peter-simon-magus", "title": "願你的銀錢與你一起喪亡", "to": "術士西滿", "refs": { "act": ["8:20-23"] }, "key": "act 8:20", "reply": { "act": ["8:24"] }, "replyBy": "西滿", "note": "與若望同往撒瑪黎雅（8:14）；西滿獻銀錢，求能賜人聖神的權柄（8:18-19）。", "see": ["peter-ananias", "paul-elymas"] },
            { "id": "peter-aeneas", "title": "耶穌基督治好你了", "to": "癱瘓的艾乃阿", "refs": { "act": ["9:34"] }, "key": "act 9:34", "note": "在里達；艾乃阿癱瘓躺在床上已有八年（9:33）。", "see": ["peter-tabitha"] },
            { "id": "peter-tabitha", "title": "塔彼達，起來", "to": "死去的塔彼達", "refs": { "act": ["9:40"] }, "key": "act 9:40", "note": "約培的女門徒，希臘文名多爾卡（9:36）；寡婦們哭著把她所製的衣服指給他看（9:39）。", "see": ["paul-eutychus", "peter-aeneas"] }
          ]
        },
        {
          "title": "外邦人也蒙召",
          "sayings": [
            { "id": "peter-vision-joppa", "title": "主，絕對不可", "to": "天上的聲音", "refs": { "act": ["10:14"] }, "key": "act 10:14", "reply": { "act": ["10:15"] }, "replyBy": "聲音", "note": "與瑪16:22「主，千萬不可！」措辭相近；這事一連發生三次（10:16）。", "see": ["peter-rebuke", "peter-explain-jerusalem", "peter-council", "peter-i-am-the-man", "peter-just-a-man"] },
            { "id": "peter-i-am-the-man", "title": "我就是你們所找的人", "to": "科爾乃略的人", "refs": { "act": ["10:21"] }, "key": "act 10:21", "reply": { "act": ["10:22"] }, "replyBy": "科爾乃略的人", "note": "聖神先吩咐他同來人一起去，不必疑惑（10:19-20）。", "see": ["peter-vision-joppa"] },
            { "id": "peter-just-a-man", "title": "沒有一個可說是污穢或不潔的人", "to": "科爾乃略和親友", "refs": { "act": ["10:26", "10:28-29"] }, "key": "act 10:28", "reply": { "act": ["10:30-33"] }, "replyBy": "科爾乃略", "note": "10:26 他拉起跪拜的科爾乃略，說「我自己也是個人」；對照保祿在宗14:15。", "see": ["paul-lystra-speech", "peter-vision-joppa"] },
            { "id": "peter-cornelius-speech", "title": "天主是不看情面的", "to": "科爾乃略一家", "refs": { "act": ["10:34-43"] }, "key": "act 10:34", "reply": { "act": ["10:44-45"] }, "replyBy": "聖神", "note": "概述耶穌從加里肋亞開始的事跡、受難與復活（10:37-41）。", "see": ["peter-pentecost", "peter-who-can-forbid"] },
            { "id": "peter-who-can-forbid", "title": "誰能阻止他們不受水洗呢", "to": "同來的信徒", "refs": { "act": ["10:47"] }, "key": "act 10:47", "note": "聖神降在外邦人身上，他們說各種語言，並頌揚天主（10:44-46）。", "see": ["peter-explain-jerusalem", "peter-council", "peter-cornelius-speech"] },
            { "id": "peter-explain-jerusalem", "title": "我是什麼人，能阻止天主呢", "to": "受割損的人", "refs": { "act": ["11:5-17"] }, "key": "act 11:17", "reply": { "act": ["11:18"] }, "replyBy": "眾人", "note": "回應「你竟進了未受割損人的家」的非難（11:3）；按次重述宗10 的經過。", "see": ["peter-vision-joppa", "peter-who-can-forbid", "peter-council"] },
            { "id": "peter-prison-escape", "title": "現今我實在知道主派了他的天使來", "to": "自己", "refs": { "act": ["12:11"] }, "key": "act 12:11", "note": "黑落德要在逾越節後提審他，教會一直為他向天主祈禱（12:4-5）。", "see": ["peter-tell-james"] },
            { "id": "peter-tell-james", "title": "報告給雅各伯和弟兄們", "to": "聚集祈禱的人", "refs": { "act": ["12:17"] }, "key": "act 12:17", "note": "在若望（號稱馬爾谷）的母親瑪利亞家（12:12）；此後他「往別的地方去了」。", "see": ["james-council", "peter-council", "peter-prison-escape"] },
            { "id": "peter-council", "title": "你們為什麼試探天主", "to": "宗徒和長老", "refs": { "act": ["15:7-11"] }, "key": "act 15:11", "reply": { "act": ["15:13-21"] }, "replyBy": "雅各伯", "note": "回顧科爾乃略一家領受聖神的事（宗10）；這是宗徒大事錄裡他最後一次發言。", "see": ["james-council", "peter-vision-joppa", "peter-explain-jerusalem", "peter-who-can-forbid", "peter-tell-james"] }
          ]
        }
      ]
    },
    {
      "id": "andrew",
      "name": "安德肋",
      "group": "twelve",
      "intro": "貝特賽達人，西滿伯多祿的哥哥；原是洗者若翰的門徒（若1:40）。",
      "stages": [
        {
          "title": "初遇耶穌",
          "sayings": [
            { "id": "andrew-where-stay", "title": "你住在那裡", "to": "耶穌", "refs": { "jhn": ["1:38"] }, "key": "jhn 1:38", "reply": { "jhn": ["1:39"] }, "replyBy": "耶穌", "note": "與另一位門徒一起問；1:40 說明安德肋是那兩人之一。", "see": ["andrew-found-messiah", "philip-come-and-see"] },
            { "id": "andrew-found-messiah", "title": "我們找到了默西亞", "to": "他弟弟西滿", "refs": { "jhn": ["1:41"] }, "key": "jhn 1:41", "reply": { "jhn": ["1:42"] }, "replyBy": "耶穌", "note": "他先找到自己的弟弟西滿，領他到耶穌跟前（1:41-42）。", "see": ["peter-confess", "philip-come-and-see", "andrew-where-stay"] }
          ]
        },
        {
          "title": "五餅二魚",
          "sayings": [
            { "id": "andrew-five-loaves", "title": "這裡有一個兒童", "to": "耶穌", "refs": { "jhn": ["6:9"] }, "key": "jhn 6:9", "reply": { "jhn": ["6:10"] }, "replyBy": "耶穌", "note": "斐理伯剛說二百塊「德納」的餅也不夠（6:7）；瑪14:17 作「門徒」說「只有五個餅和兩條魚」。", "see": ["philip-two-hundred", "disciples-feed-crowd"] }
          ]
        }
      ]
    },
    {
      "id": "zebedee",
      "name": "雅各伯與若望",
      "aka": ["載伯德的兒子", "波納爾革"],
      "group": "twelve",
      "intro": "載伯德的兒子，加里肋亞的漁夫；耶穌給他們起名「波納爾革」，就是「雷霆之子」。",
      "stages": [
        {
          "title": "同行的日子",
          "sayings": [
            { "id": "zebedee-forbade", "title": "我們禁止了他", "to": "耶穌", "refs": { "mrk": ["9:38"], "luk": ["9:49"] }, "key": "mrk 9:38", "reply": { "mrk": ["9:39-40"], "luk": ["9:50"] }, "replyBy": "耶穌", "note": "這裡是若望一人說話，說的是「我們」；他們見一個不跟從他們的人奉耶穌的名驅魔。", "see": ["zebedee-fire", "disciples-greatest"] },
            { "id": "zebedee-fire", "title": "叫火自天降下", "to": "耶穌", "refs": { "luk": ["9:54"] }, "key": "luk 9:54", "reply": { "luk": ["9:55"] }, "replyBy": "耶穌", "note": "撒瑪黎雅人的一個村莊不接待面朝耶路撒冷去的耶穌（9:52-53）；兩兄弟同聲發問。", "see": ["zebedee-forbade", "zebedee-seats"] }
          ]
        },
        {
          "title": "上耶路撒冷的路上",
          "sayings": [
            { "id": "zebedee-seats", "title": "一個坐在你右邊，一個坐在你左邊", "to": "耶穌", "refs": { "mrk": ["10:35", "10:37", "10:39"], "mat": ["20:22"] }, "key": "mrk 10:37", "reply": { "mrk": ["10:40"], "mat": ["20:23"] }, "replyBy": "耶穌", "note": "瑪20:20-21 說是他們的母親出面請求，兩人只在瑪20:22 答「我們能」。", "see": ["zebedee-fire", "disciples-greatest"] }
          ]
        }
      ]
    },
    {
      "id": "philip",
      "name": "斐理伯",
      "group": "twelve",
