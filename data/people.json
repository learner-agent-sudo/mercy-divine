            { "id": "paul-appeal-caesar", "title": "我向凱撒上訴", "to": "總督斐斯托", "refs": { "act": ["25:8", "25:10-11"] }, "key": "act 25:11", "reply": { "act": ["25:12"] }, "replyBy": "斐斯托", "note": "斐斯托問他願不願上耶路撒冷受審（25:9），他不從，改向凱撒上訴。", "see": ["paul-defence-agrippa", "paul-storm-assurance", "paul-rome-jews"] },
            { "id": "paul-defence-agrippa", "title": "我對這天上的異像並沒有失信", "to": "阿格黎帕王", "refs": { "act": ["26:2-23"] }, "key": "act 26:19", "reply": { "act": ["26:24"] }, "replyBy": "斐斯托", "note": "宗9 由敘述者講歸化的事，宗22、26 是保祿自己再述；這裡主親口託付他（26:16-18）。", "see": ["paul-who-are-you", "paul-defence-crowd", "paul-almost", "paul-appeal-caesar"] },
